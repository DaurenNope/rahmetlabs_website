# ------------------------------------------------------------------
# Rahmet Labs — environment variables
# Copy this file to .env.local and fill in. Never commit real keys.
# ------------------------------------------------------------------

# --- Newsletter (choose ONE provider; Kit is the recommended default) ---

# Kit / ConvertKit (free up to 300 subscribers)
# Find both in Kit -> Account Settings -> Advanced -> API, and the Form ID
# under Grow -> Landing Pages & Forms -> (your form) -> Edit -> Form ID.
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# Mailchimp (free up to 500 contacts)
# Server prefix is the part before ".api.mailchimp.com" in your account URL.
# MAILCHIMP_API_KEY=
# MAILCHIMP_SERVER_PREFIX=
# MAILCHIMP_LIST_ID=

# Buttondown
# BUTTONDOWN_API_KEY=

# --- Analytics (opt-in; no-op until set) ---

# Google Analytics 4 measurement ID (G-XXXXXXXXXX)
# NEXT_PUBLIC_GA4_ID=

# Plausible site domain
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
